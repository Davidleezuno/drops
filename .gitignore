# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (the placeholder template is safe to commit)
.env*
!.env.example

# vercel
.vercel

# supabase local link/cache
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
/.worktrees/

# local agent/editor state
/.claude/
/.compound-engineering/config.local.yaml
/.frontend-slides/

# generated or internal working material
/dogfood-output/
/presentation-prep/
/design-qa.md

# disposable storefront experiments
/app/prototype/
/public/prototype/

/archive/